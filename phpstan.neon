includes:
  - vendor/mglaman/phpstan-drupal/extension.neon
  - vendor/tomasvotruba/cognitive-complexity/config/extension.neon

parameters:
  level: 2
  paths:
    - src/
  cognitive_complexity:
    class: 50
    function: 12
    dependency_tree: 150
  ignoreErrors:
    - '#Unsafe usage of new static\(\)#'
